        <mxCell id="browser" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Players in browsers&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;Next.js client / React / TypeScript&lt;br&gt;Canvas 2D + Pointer Events&lt;br&gt;Paint locally; send stroke batches&lt;br&gt;Render team canvas + shared hints&lt;br&gt;ACK rendered canvas + hint versions&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#d1fae5;strokeColor=#047857;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="220" width="420" height="240" />
        </mxCell>
        <mxCell id="game" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;NestJS game backend&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px;margin-top:16px;&quot;&gt;Node.js + TypeScript + NestJS&lt;br&gt;Socket.IO gateway + HTTP controllers&lt;br&gt;RAM: canvas, clock, roles, scores&lt;br&gt;Serialized match events / dedupe / privacy&lt;br&gt;AI checkpoints + result validation&lt;br&gt;One active game process; many matches&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=21;" vertex="1" parent="1">
