        </mxCell>
        <mxCell id="db" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;PostgreSQL | saved game data&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;Match setup + finalized round results&lt;br&gt;Archived drawing events + AI attempts&lt;br&gt;Input artifacts + model/config versions&lt;br&gt;Prisma access through NestJS services&lt;br&gt;No SQL wait for live stroke delivery&lt;/div&gt;" style="shape=mxgraph.flowchart.database;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=40;strokeWidth=2;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2190" y="220" width="540" height="260" />
        </mxCell>
        <mxCell id="next" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Next.js web application&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;App Router + TypeScript&lt;br&gt;Tailwind CSS + shadcn/ui&lt;br&gt;Lobby / game / saved replay screens&lt;br&gt;Guest sessions + room codes&lt;br&gt;Per-stroke drawing stays outside React&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="700" width="420" height="230" />
        </mxCell>
        <mxCell id="render" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Canonical render workers&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;Render accepted drawing operations&lt;br&gt;PNG/compression off game event loop&lt;br&gt;Snapshot hash + canvas/hint versions&lt;br&gt;AI release waits for render ACKs&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="700" width="450" height="230" />
        </mxCell>
        <mxCell id="ai" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Python AI service&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px;margin-top:16px;&quot;&gt;FastAPI + Pydantic contracts&lt;br&gt;Bounded admission / deadlines&lt;br&gt;POST jobs; push completions&lt;br&gt;Retry notifications; ACK job IDs&lt;br&gt;Authenticated internal-only link&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1810" y="700" width="390" height="230" />
        </mxCell>
        <mxCell id="models" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Loaded GPU models&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px;margin-top:16px;&quot;&gt;PyTorch + Transformers&lt;br&gt;Qwen3-VL-2B: guesser*&lt;br&gt;Florence-2-base: referee*&lt;br&gt;Loaded weights; fair scheduling&lt;br&gt;Separate logical jobs per team&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2380" y="700" width="350" height="250" />
        </mxCell>
        <mxCell id="trace" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Metrics / logs&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:26px;margin-top:16px;&quot;&gt;Draw latency, queues, reconnects&lt;br&gt;Langfuse optional; sanitized inputs&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#fef3c7;strokeColor=#b45309;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=18;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2380" y="990" width="350" height="140" />
        </mxCell>
        <mxCell id="research" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Sketch-focused comparison&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;Python / pandas / notebooks&lt;br&gt;Authorized matched-sketch exports&lt;br&gt;No gameplay hints or AI handicap&lt;br&gt;Target correctness is primary&lt;br&gt;Timing secondary; explanations later&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#d1fae5;strokeColor=#047857;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1160" width="420" height="250" />
        </mxCell>
        <mxCell id="modules" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Inside the NestJS backend&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px;margin-top:16px;&quot;&gt;Rooms / teams / guest-session services&lt;br&gt;In-process match registry + match engines&lt;br&gt;Round lifecycle + scoring services&lt;br&gt;AI connector + rendered-view barrier&lt;br&gt;Prisma persistence + replay/export services&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="1160" width="630" height="250" />
        </mxCell>
        <mxCell id="archive" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Archive + export worker&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;NestJS-owned background module&lt;br&gt;Bounded RAM queue; batched SQL writes&lt;br&gt;Persist replay events and model inputs&lt;br&gt;Flush round events before finalization&lt;br&gt;Serve authorized replay / research API&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#dbeafe;strokeColor=#1d4ed8;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2190" y="1160" width="540" height="220" />
        </mxCell>
        <mxCell id="policy" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Gameplay and privacy contract&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px;margin-top:16px;&quot;&gt;Agreed team counts/sizes, including unequal teams; one rotating drawer, all others guess.&lt;br&gt;One team score on its first correct answer; all teams use the same prompt and hint clock.&lt;br&gt;Only drawers know the target; team canvases and AI guess text remain private until reveal.&lt;br&gt;Referee flags are public and advisory; private text and image crops stay team-scoped.&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=21;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1540" width="1300" height="200" />
        </mxCell>
        <mxCell id="reliability" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;Acceptance, reconnects and persistence&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px;margin-top:16px;&quot;&gt;Ordered RAM updates and live broadcast; PostgreSQL archival runs in the background.&lt;br&gt;Reconnects can resume live state while the game process is running.&lt;br&gt;Game process restart: void unfinished rounds; restore only committed saved results.&lt;br&gt;Team grace/forfeit and round-wide AI-outage bonus rules remain in effect.&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;spacingTop=18;strokeWidth=2;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Segoe UI;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="1540" width="1200" height="200" />
        </mxCell>
